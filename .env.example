# Yiriba License Server — Configuration
# Copier ce fichier en .env et remplir les valeurs

# Clé secrète HMAC (MÊME clé que dans LicenseManager.cs)
YIRIBA_SECRET=SM-Licence-HMAC-2026-BurkinaFaso-SecretKey!@#$%

# Token admin (pour /api/admin/*)
YIRIBA_ADMIN_TOKEN=CHANGE_ME_TO_A_SECURE_TOKEN

# Port du serveur
YIRIBA_PORT=5000

# Base de données SQLite
YIRIBA_DB=licenses.db

# Nombre max d'activations par licence
YIRIBA_MAX_ACTIVATIONS=5
